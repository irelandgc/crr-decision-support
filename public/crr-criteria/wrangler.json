{
  "name": "crr-criteria-api",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "api/worker.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crr-criteria",
      "database_id": "1a8307f9-69e9-4315-a8f3-7f6737dd9c55"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "d8e1a512828d4dd7981d7b241213f396"
    }
  ],
  "vars": {
    "ASSESS_PIPELINE_ENABLED": "false",
    "ASSESS_ALLOW_SIGNED_OFF": "false",
    "AUDIT_STORE_REDACTED_NOTE": "false",
    "AUDIT_NOTE_RETENTION_DAYS": "180",
    "EXTRACTION_PROVIDER": "anthropic",
    "EXTRACTION_MODEL": "claude-sonnet-4-6",
    "EXTRACTION_MAX_TOKENS": "8000"
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "env": {
    "staging": {
      "name": "crr-criteria-api-staging",
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "crr-criteria-staging",
          "database_id": "2b0fdd0d-afa4-4f82-92c6-d7b6b85e8d3d"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "6eebb130a23c4046baf3e48cdc32058f"
        }
      ],
      "vars": {
        "ASSESS_PIPELINE_ENABLED": "true",
        "ASSESS_ALLOW_SIGNED_OFF": "false",
        "AUDIT_STORE_REDACTED_NOTE": "false",
        "AUDIT_NOTE_RETENTION_DAYS": "180",
        "EXTRACTION_PROVIDER": "anthropic",
        "EXTRACTION_MODEL": "claude-sonnet-4-6",
        "EXTRACTION_MAX_TOKENS": "8000"
      }
    }
  }
}
