  "version": "1.0.0",
  "name": "CRR_USRenal_Adult_Indicators",
  "title": "US Renal - Adult: referral indicators",
  "status": "draft",
  "date": "2026-10-15",
  "publisher": "Health New Zealand | Te Whatu Ora - Community Referred Radiology Programme",
  "description": "Atomic clinical indicators for the US Renal (Adult) national referral criteria (National Community Referral Criteria for Imaging Part I, v2.0, published 09/04/2026, pp.52-55). NOT CLINICALLY REVIEWED (W1 demo transcription, AD-35). The LLM extraction step, structured referral forms and the Criteria Viewer tick-list all produce a QuestionnaireResponse against this Questionnaire, which the CQL library CRR_USRenal_Adult evaluates. Each answer may carry the answer-evidence extension (status documented|inferred, quote). No population library: no item is populated from the patient record.",
  "extension": [
    {
      "url": "http://hl7.org/fhir/StructureDefinition/cqf-library",
      "valueCanonical": "http://crr.health.nz/fhir/Library/CRR_USRenal_Adult"
    }
  ],
