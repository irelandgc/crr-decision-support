{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vite-react-template",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"vars": {
		"ASSESS_PIPELINE_ENABLED": "false",
		"ACCESS_AUD": "3f02b724d2d9c56c101fc8042cbdeefad03ccb7cd539d400c1777e1eff699e80",
		"ACCESS_TEAM_DOMAIN": "https://crr-admin.cloudflareaccess.com"
	},
	"services": [
		{ "binding": "CRR_API", "service": "crr-criteria-api" }
	],
	"upload_source_maps": true,
	"preview_urls": false,
	"env": {
		// AD-34 staging: deployed by hand (`CLOUDFLARE_ENV=staging npm run build && npx wrangler deploy`), never by Workers Builds.
		"staging": {
			"name": "vite-react-template-staging",
			"vars": {
				"ASSESS_PIPELINE_ENABLED": "true",
				"ACCESS_AUD": "3f02b724d2d9c56c101fc8042cbdeefad03ccb7cd539d400c1777e1eff699e80",
				"ACCESS_TEAM_DOMAIN": "https://crr-admin.cloudflareaccess.com"
			},
			"services": [
				{ "binding": "CRR_API", "service": "crr-criteria-api-staging" }
			]
		}
	},
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": ["/crr-api/*", "/api/*"]
	}
}
